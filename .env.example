DATABASE_URL="postgresql://icesco:icesco_dev@localhost:5434/icesco_knowledge_forum"
JWT_SECRET="change-me-in-production"

# --- Volet IA (voir docs/AI_ARCHITECTURE.md pour le detail et le raisonnement) ---

# LLM principal : Qwen3.6-27b via Groq (retenu apres tests comparatifs sur 7 candidats —
# meilleure fidelite observee, pas d'hallucination detectee sur les cas testes).
# Cle gratuite sur https://console.groq.com
GROQ_API_KEY=""
GROQ_LLM_MODEL="qwen/qwen3.6-27b"

# Modele de repli, plus rapide/economique, utilise pour le resume live (haut volume).
GROQ_FALLBACK_MODEL="openai/gpt-oss-20b"

# Embeddings : Gemini Embedding retenu pour la PRODUCTION (deploiement serverless,
# pas de GPU disponible en continu) — Qwen3-Embedding-0.6B avait une meilleure
# separation naturelle en test mais demande un hebergement dedie, incompatible avec
# une architecture Next.js serverless sans serveur d'inference a part.
# Cle gratuite sur https://aistudio.google.com
GEMINI_API_KEY=""
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# Moderation : endpoint hebergeant Qwen3Guard-Gen-0.6B (ex: HF Inference Endpoints,
# ou tout hebergeur exposant le meme modele). Laisser vide pour utiliser uniquement
# le repli heuristique local (voir lib/ai/clients/moderation.ts).
MODERATION_ENDPOINT_URL=""
MODERATION_ENDPOINT_KEY=""

# Vector store : Qdrant Cloud (filtrage par metadonnees valide en test).
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="ykf2026_forum"

# Recherche web pour la branche "actualite" du concierge general.
# Tavily — API concue pour les agents/RAG, verifiee sur docs.tavily.com avant integration.
# Optionnel au demarrage : sans cle, cette branche repond honnetement qu'elle
# ne peut pas verifier l'actualite plutot que d'inventer (voir orchestrator.ts).
# Cle gratuite (tier d'essai) sur https://app.tavily.com
TAVILY_API_KEY=""

# --- Observabilite (optionnel) ---
# Langfuse — sans ces 3 variables, les evenements IA sont simplement affiches
# dans les logs serveur (console.log) plutot que perdus silencieusement.
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST=""

# --- Scheduler (cycle automatique de resume live) ---
# Secret partage verifie par app/api/ai/cron/route.ts avant d'executer quoi
# que ce soit — genere une valeur aleatoire longue, ex: openssl rand -hex 32
CRON_SECRET=""
