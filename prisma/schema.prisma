// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccessRole {
  admin
  delegate
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  avatar       String?
  role         String
  accessRole   AccessRole @default(delegate)
  country      String
  level        Int        @default(1)
  levelTitle   String     @default("Newcomer")
  xp           Int        @default(0)
  xpMax        Int        @default(1000)
  lastSeenAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())

  certificates        Certificate[]
  badges              Badge[]
  skills              Skill[]
  progressItems       ProgressItem[]
  activity            ActivityLogEntry[]
  bookmarks           Bookmark[]
  connectionsSent     Connection[]       @relation("ConnectionSender")
  connectionsReceived Connection[]       @relation("ConnectionReceiver")
  messagesSent        DirectMessage[]    @relation("MessageSender")
  messagesReceived    DirectMessage[]    @relation("MessageReceiver")
  chatMessages        ChatMessage[]
  pollVotes           PollVote[]
  questions           Question[]
  questionUpvotes     QuestionUpvote[]
  liveNote            LiveNote?
  crisisCityProfile   CrisisCityProfile?
  notifications       Notification[]     @relation("NotificationRecipient")
  notificationsCaused Notification[]     @relation("NotificationActor")
  presenceDays        PresenceDay[]
  sessionAttendance   SessionAttendance[]
  resourceReads       ResourceRead[]
  posters             Poster[]

  @@map("users")
}

// Carrière Crisis City (XP/badges/scénarios) — séparée des tables passeport génériques
// ci-dessus (Badge/Skill/ProgressItem/ActivityLogEntry appartiennent au passeport de la
// plateforme) : deux systèmes de progression distincts, un par utilisateur. Les champs JSON
// reprennent exactement la forme de l'objet `progress` de Crisis City
// (components/crisis-city/engine/persistence.js#emptyProgress) pour ne rien changer à sa
// logique métier (xp.js/badges.js) lors du portage.
model CrisisCityProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  xpEvents     Json     @default("{}")
  badgesEarned Json     @default("{}")
  scenarios    Json     @default("{}")
  updatedAt    DateTime @updatedAt

  @@map("crisis_city_profiles")
}

model Country {
  id      String @id @default(cuid())
  name    String @unique
  isoCode String @unique
  flag    String
  lat     Float
  lng     Float

  @@map("countries")
}

model ProgramDay {
  id       String           @id
  label    String
  date     String
  sessions ProgramSession[]

  @@map("program_days")
}

model Speaker {
  id       String           @id @default(cuid())
  name     String
  role     String
  initials String
  sessions ProgramSession[]

  @@map("speakers")
}

model ProgramSession {
  id        String     @id @default(cuid())
  dayId     String
  day       ProgramDay @relation(fields: [dayId], references: [id])
  time      String
  duration  String
  title     String
  track     String
  room      String
  speakerId String?
  speaker   Speaker?   @relation(fields: [speakerId], references: [id])
  startsAt  DateTime
  endsAt    DateTime

  bookmarks         Bookmark[]
  sessionAttendance SessionAttendance[]

  @@map("program_sessions")
}

// Assiduité mesurée par le heartbeat de présence (lib/gamification/presence.ts) — un
// enregistrement par (participant, session). `suivi` bascule à `true` une fois le seuil de
// présence active atteint (config.ts), ce qui déclenche le certificat de panel et alimente le
// calcul du certificat de participation globale (75 % des panels programmés).
model SessionAttendance {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  sessionId       String
  session         ProgramSession @relation(fields: [sessionId], references: [id])
  activeSeconds   Int            @default(0)
  xpAwarded       Int            @default(0)
  suivi           Boolean        @default(false)
  lastHeartbeatAt DateTime?

  @@unique([userId, sessionId])
  @@map("session_attendance")
}

model Bookmark {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  sessionId String
  session   ProgramSession @relation(fields: [sessionId], references: [id])
  createdAt DateTime       @default(now())

  @@unique([userId, sessionId])
  @@map("bookmarks")
}

enum CertificateStatus {
  issued
  in_progress
  locked
}

model Certificate {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  title     String
  type      String
  code      String?
  status    CertificateStatus
  issuedAt  DateTime?
  // Clé d'émission idempotente (ex. "PANEL_CERT:{sessionId}:{userId}") posée par
  // lib/gamification/certificates.ts#issueCertificateOnce — évite les doublons si l'évaluation
  // (heartbeat, pont atelier, etc.) est déclenchée plusieurs fois pour le même jalon.
  sourceKey String?           @unique

  @@map("certificates")
}

model Badge {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  label  String
  icon   String

  @@map("badges")
}

model Skill {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  label  String
  value  Int

  @@map("skills")
}

model ProgressItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  label  String
  value  Int
  max    Int

  @@map("progress_items")
}

model ActivityLogEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  meta      String
  xp        Int
  createdAt DateTime @default(now())
  // Clé d'idempotence posée par lib/gamification/xp.ts#awardXp (ex.
  // "PRESENCE_PANEL:{userId}:{sessionId}:{n}") — nullable pour ne pas casser les lignes
  // hardcodées de prisma/seed.ts, qui n'en ont pas besoin (jamais rejouées).
  key       String?  @unique

  @@map("activity_log_entries")
}

enum ConnectionStatus {
  pending
  accepted
}

model Connection {
  id         String           @id @default(cuid())
  fromUserId String
  fromUser   User             @relation("ConnectionSender", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User             @relation("ConnectionReceiver", fields: [toUserId], references: [id])
  status     ConnectionStatus @default(pending)
  createdAt  DateTime         @default(now())
  // Posé au moment où `status` passe à `accepted` — sert au plafond journalier d'XP de
  // réseautage et à la fenêtre de 48h du bonus "premier message" (lib/gamification).
  acceptedAt DateTime?

  @@unique([fromUserId, toUserId])
  @@map("connections")
}

model DirectMessage {
  id         String    @id @default(cuid())
  fromUserId String
  fromUser   User      @relation("MessageSender", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User      @relation("MessageReceiver", fields: [toUserId], references: [id])
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([fromUserId, toUserId])
  @@index([toUserId, fromUserId])
  @@map("direct_messages")
}

enum NotificationType {
  connection_request
  connection_accepted
  message
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id])
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id])
  type      NotificationType
  body      String
  link      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

/**
 * Admin-controlled visibility per nav-rail page — absence of a row means
 * enabled, so most pages never need one. Keyed by NavItem.key from lib/nav.ts.
 */
model PageFlag {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("page_flags")
}

enum ResourceType {
  report
  case
  tool
  training
  policy
}

model Resource {
  id       String       @id @default(cuid())
  title    String
  type     ResourceType
  category String
  country  String?
  language String?
  featured Boolean      @default(false)
  tag      String?
  image    String?
  url      String?
  addedAt  DateTime     @default(now())

  reads ResourceRead[]

  @@map("resources")
}

// Suivi de lecture Knowledge Hub — un enregistrement par (participant, ressource). Le temps de
// lecture est accumulé par le même heartcheat de présence que l'assiduité aux panels
// (lib/gamification/presence.ts) ; `completedAt` se pose une fois le seuil de lecture minimal
// franchi, ce qui octroie l'XP une seule fois.
model ResourceRead {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  resourceId      String
  resource        Resource  @relation(fields: [resourceId], references: [id])
  secondsSpent    Int       @default(0)
  completedAt     DateTime?
  lastHeartbeatAt DateTime?

  @@unique([userId, resourceId])
  @@map("resource_reads")
}

enum TwinStatus {
  operational
  warning
  flood_risk
}

model TwinBuilding {
  id     String     @id
  name   String
  status TwinStatus
  x      Float
  y      Float

  @@map("twin_buildings")
}

model EventMetric {
  id    String @id @default(cuid())
  key   String @unique
  value Int

  @@map("event_metrics")
}

model ChatMessage {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@map("live_chat_messages")
}

model Poll {
  id       String       @id @default(cuid())
  question String
  active   Boolean      @default(true)
  options  PollOption[]

  @@map("polls")
}

model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id])
  label     String
  order     Int
  seedCount Int        @default(0)
  votes     PollVote[]

  @@map("poll_options")
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id])
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([pollId, userId])
  @@map("poll_votes")
}

model Question {
  id          String           @id @default(cuid())
  userId      String?
  user        User?            @relation(fields: [userId], references: [id])
  authorName  String
  body        String
  seedUpvotes Int              @default(0)
  createdAt   DateTime         @default(now())
  upvotes     QuestionUpvote[]

  @@map("live_questions")
}

model QuestionUpvote {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  @@unique([questionId, userId])
  @@map("live_question_upvotes")
}

model LiveNote {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  body      String
  updatedAt DateTime @updatedAt

  @@map("live_notes")
}

// Présence générale (hors panel en direct, hors lecture Knowledge Hub) — un enregistrement par
// (participant, jour calendaire), alimenté par le même heartbeat que SessionAttendance/
// ResourceRead. `generalXpAwarded` mémorise l'XP déjà créditée pour ce jour afin que
// awardXp() ne recrédite jamais la même tranche de 6 minutes deux fois.
model PresenceDay {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  day              String
  generalSeconds   Int       @default(0)
  generalXpAwarded Int       @default(0)
  lastHeartbeatAt  DateTime?

  @@unique([userId, day])
  @@map("presence_days")
}

// Poster Studio n'avait aucune persistance avant le système XP — cette table remplace l'état
// purement client de components/poster/poster-studio.tsx. `published` ne bascule qu'une fois
// (jamais republié à `false`), ce qui rend l'octroi des 20 XP naturellement unique par affiche.
model Poster {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  template    String
  title       String
  subtitle    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("posters")
}
